# ダミー値です。実値は .env にだけ書き、Git にコミットしないでください。

POSTGRES_USER=recorder
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=live_recorder
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ホスト側のパス。コンテナ内のパスではありません。
DATABASE_DIR=./data/database
RECORDINGS_DIR=./data/recordings
CONFIG_DIR=./data/config

WEB_BIND=0.0.0.0
WEB_PORT=8080
PUID=1000
PGID=1000
TZ=Asia/Tokyo

# 32文字以上。例示の文字列のままでは起動しません。
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-chars

DISPLAY_TIMEZONE=Asia/Tokyo
LOG_LEVEL=INFO
# LAN の HTTP では false。HTTPS 終端の背後では true。
COOKIE_SECURE=false

# ツイキャス開発者コンソールの Client ID / Secret。
# 公式 API は Basic 認証（アプリ単位）で読み取りできます。
TWITCASTING_CLIENT_ID=
TWITCASTING_CLIENT_SECRET=
# ユーザ認可で取得した Bearer トークンを使う場合のみ。
TWITCASTING_ACCESS_TOKEN=

# TikTok コメントと第3録画手段で使う Euler Stream の API キー。無くても配信検知と Streamlink 録画は動作します。
SIGN_API_KEY=

# create-admin が読む初期管理者。常駐プロセスはパスワードを使いません。
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
